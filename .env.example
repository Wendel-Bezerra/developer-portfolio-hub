## API (nodemailer) - configuração SMTP
PORT=3001

# Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=Wendel.2929@gmail.com
# Use uma senha de app do Gmail (não use sua senha normal)
SMTP_PASS=

# Para onde você quer receber as mensagens do formulário
MAIL_TO=Wendel.2929@gmail.com

# Opcional: remetente (se vazio, usa "Portfólio <SMTP_USER>")
MAIL_FROM=Portfólio <Wendel.2929@gmail.com>

# Anti-spam (opcional)
# Janela de tempo em ms e máximo de envios por IP nessa janela
CONTACT_RATE_WINDOW_MS=600000
CONTACT_RATE_MAX=3

# Tempo mínimo/máximo para preencher e enviar o formulário (ms)
CONTACT_MIN_FILL_MS=3000
CONTACT_MAX_FILL_MS=7200000

# Cloudflare Turnstile (Captcha)
# Frontend (público)
VITE_TURNSTILE_SITE_KEY=
# Backend (secreto)
TURNSTILE_SECRET_KEY=

